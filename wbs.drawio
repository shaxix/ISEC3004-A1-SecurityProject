<mxfile host="app.diagrams.net"><diagram name="WBS"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style='font-size:17px'&gt;ISEC3004 Group Security Project&lt;/b&gt;&lt;br&gt;&lt;span style='color:#52514e'&gt;Group 48 · CSRF + Path Traversal&lt;/span&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f0ec;strokeColor=#0b0b0b;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="306.0" y="0.0" width="420.0" height="70.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=none;html=1;strokeColor=#7d7c78;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516.0" y="70" as="sourcePoint"/><mxPoint x="516.0" y="100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#7d7c78;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="100" as="sourcePoint"/><mxPoint x="912.0" y="100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="" style="endArrow=none;html=1;strokeColor=#7d7c78;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="100" as="sourcePoint"/><mxPoint x="120.0" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;1.0 Project Management&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#52514e'&gt;Lead: Indiana&lt;/span&gt;" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor=#dbe8f8;strokeColor=#2a78d6;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0.0" y="130.0" width="240.0" height="52.0" as="geometry"/></mxCell><mxCell id="c8" value="1.1 Weekly meetings + minutes&lt;br&gt;1.2 In-person session (28 Sep)&lt;br&gt;1.3 Jira setup + organisation&lt;br&gt;1.4 Effort estimation, WBS, Gantt&lt;br&gt;1.5 Weekly progress checks" style="fontFamily=Helvetica;rounded=0;whiteSpace=wrap;html=1;fillColor